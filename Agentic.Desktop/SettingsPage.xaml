<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Agentic_Desktop.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Agentic_Desktop"
    xmlns:converters="using:Agentic.Desktop.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Agentic.Desktop.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <StackPanel Spacing="16" MaxWidth="600" Margin="24"
                        HorizontalAlignment="Left">

                <!-- Agent 配置 -->
                <TextBlock Text="Agent 配置" FontSize="20" FontWeight="SemiBold" />

                <StackPanel Spacing="4">
                    <TextBlock Text="Agent 路径" FontWeight="SemiBold" />
                    <TextBox x:Name="AgentPathTextBox"
                             AutomationProperties.AutomationId="AgentPathTextBox"
                             Text="{x:Bind ViewModel.AgentPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="留空使用 Mock Agent，或输入 Agent 可执行文件路径" />
                    <TextBlock Text="留空将使用内置 Mock Agent 进行演示" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Agent 参数" FontWeight="SemiBold" />
                    <TextBox x:Name="AgentArgumentsTextBox"
                             AutomationProperties.AutomationId="AgentArgumentsTextBox"
                             Text="{x:Bind ViewModel.AgentArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="可选，例如: run --project path/to/project" />
                    <TextBlock Text="启动 Agent 时传递给命令的参数" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="工作目录" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WorkingDirectoryTextBox"
                                 Grid.Column="0"
                                 AutomationProperties.AutomationId="WorkingDirectoryTextBox"
                                 Text="{x:Bind ViewModel.WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Agent 的工作目录" />
                        <Button x:Name="BrowseButton"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="BrowseDirectoryButton"
                                Content="浏览..."
                                Click="BrowseButton_Click"
                                VerticalAlignment="Stretch" />
                    </Grid>
                </StackPanel>

                <!-- 连接控制 -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button x:Name="ConnectButton"
                            AutomationProperties.AutomationId="ConnectButton"
                            Command="{x:Bind ViewModel.ConnectCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="连接" />
                    <Button x:Name="DisconnectButton"
                            AutomationProperties.AutomationId="DisconnectButton"
                            Command="{x:Bind ViewModel.DisconnectCommand}"
                            Content="断开" />
                    <ProgressRing x:Name="ConnectingRing"
                                  IsActive="{x:Bind ViewModel.IsConnecting, Mode=OneWay}"
                                  Width="20" Height="20"
                                  VerticalAlignment="Center" />
                </StackPanel>

                <!-- 连接状态 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="16"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Margin="0,8,0,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="连接状态" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE77B;" FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon Glyph="&#xE99A;" FontSize="14"
                                      Foreground="{ThemeResource SystemAccentColor}" />
                            <TextBlock>
                                <Run Text="Agent: " />
                                <Run Text="{x:Bind ViewModel.AgentName, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon Glyph="&#xE7BA;" FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock>
                                <Run Text="Session: " />
                                <Run Text="{x:Bind ViewModel.SessionId, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
