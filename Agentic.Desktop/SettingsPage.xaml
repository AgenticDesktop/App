<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Agentic_Desktop.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Agentic_Desktop"
    xmlns:converters="using:Agentic.Desktop.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Agentic.Desktop.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <StackPanel Spacing="16" MaxWidth="600" Margin="24"
                        HorizontalAlignment="Left">

                <!-- Agent Configuration -->
                <TextBlock x:Uid="SettingsAgentConfig" FontSize="20" FontWeight="SemiBold" />

                <StackPanel Spacing="4">
                    <TextBlock x:Uid="SettingsAgentPathLabel" FontWeight="SemiBold" />
                    <TextBox x:Name="AgentPathTextBox"
                             x:Uid="SettingsAgentPathTextBox"
                             AutomationProperties.AutomationId="AgentPathTextBox"
                             Text="{x:Bind ViewModel.AgentPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock x:Uid="SettingsAgentPathHint" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock x:Uid="SettingsAgentArgsLabel" FontWeight="SemiBold" />
                    <TextBox x:Name="AgentArgumentsTextBox"
                             x:Uid="SettingsAgentArgsTextBox"
                             AutomationProperties.AutomationId="AgentArgumentsTextBox"
                             Text="{x:Bind ViewModel.AgentArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock x:Uid="SettingsAgentArgsHint" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock x:Uid="SettingsWorkDirLabel" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WorkingDirectoryTextBox"
                                 x:Uid="SettingsWorkDirTextBox"
                                 Grid.Column="0"
                                 AutomationProperties.AutomationId="WorkingDirectoryTextBox"
                                 Text="{x:Bind ViewModel.WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button x:Name="BrowseButton"
                                x:Uid="SettingsBrowseButton"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="BrowseDirectoryButton"
                                Click="BrowseButton_Click"
                                VerticalAlignment="Stretch" />
                    </Grid>
                </StackPanel>

                <!-- Connection Controls -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button x:Name="ConnectButton"
                            x:Uid="SettingsConnectButton"
                            AutomationProperties.AutomationId="ConnectButton"
                            Command="{x:Bind ViewModel.ConnectCommand}"
                            Style="{StaticResource AccentButtonStyle}" />
                    <Button x:Name="DisconnectButton"
                            x:Uid="SettingsDisconnectButton"
                            AutomationProperties.AutomationId="DisconnectButton"
                            Command="{x:Bind ViewModel.DisconnectCommand}" />
                    <ProgressRing x:Name="ConnectingRing"
                                  IsActive="{x:Bind ViewModel.IsConnecting, Mode=OneWay}"
                                  Width="20" Height="20"
                                  VerticalAlignment="Center" />
                </StackPanel>

                <!-- Connection Status -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="16"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Margin="0,8,0,0">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="SettingsConnectionStatus" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE77B;" FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon Glyph="&#xE99A;" FontSize="14"
                                      Foreground="{ThemeResource SystemAccentColor}" />
                            <TextBlock>
                                <Run Text="Agent: " />
                                <Run Text="{x:Bind ViewModel.AgentName, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon Glyph="&#xE7BA;" FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock>
                                <Run Text="Session: " />
                                <Run Text="{x:Bind ViewModel.SessionId, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
