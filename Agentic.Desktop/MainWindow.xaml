<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Agentic_Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Agentic_Desktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Agentic.Desktop"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Agentic.Desktop"
                  BackRequested="TitleBar_BackRequested"
                  IsBackButtonVisible="False"
                  IsPaneToggleButtonVisible="True"
                  PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Ellipse x:Name="StatusDot"
                             Width="8" Height="8"
                             Fill="Gray"
                             AutomationProperties.AutomationId="ConnectionStatusDot" />
                    <TextBlock x:Name="StatusText"
                               x:Uid="StatusText"
                               FontSize="12"
                               VerticalAlignment="Center"
                               AutomationProperties.AutomationId="ConnectionStatusText" />
                </StackPanel>
            </TitleBar.Content>
        </TitleBar>

        <!-- Fallback title bar for Uno (where Microsoft.UI.Xaml.Controls.TitleBar is not implemented).
             Hidden on Windows; shown on other platforms via code-behind. -->
        <Grid x:Name="AppTitleBarFallback"
              Height="40"
              Visibility="Collapsed"
              Padding="12,0"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              ColumnDefinitions="Auto,Auto,*,Auto,Auto">
            <Image Grid.Column="0"
                   Source="Assets/AppIcon.ico"
                   Width="16" Height="16"
                   VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="Agentic.Desktop"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"
                       FontWeight="SemiBold" />
            <Ellipse x:Name="StatusDotFallback"
                     Grid.Column="3"
                     Width="8" Height="8"
                     Fill="Gray"
                     VerticalAlignment="Center"
                     AutomationProperties.AutomationId="ConnectionStatusDotFallback" />
            <TextBlock x:Name="StatusTextFallback"
                       Grid.Column="4"
                       x:Uid="StatusText"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Margin="6,0,0,0"
                       AutomationProperties.AutomationId="ConnectionStatusTextFallback" />
        </Grid>

        <NavigationView x:Name="RootNavView" Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="False"
                        SelectionChanged="RootNavView_SelectionChanged"
                        Loaded="RootNavView_Loaded">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="NavChat" AutomationProperties.AutomationId="ChatNavItem" Tag="chat">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8BD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavRegistry" AutomationProperties.AutomationId="RegistryNavItem" Tag="registry">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Uid="NavSettings" AutomationProperties.AutomationId="SettingsNavItem" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="RootFrame" />
        </NavigationView>
    </Grid>
</Window>
