<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Agentic_Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Agentic_Desktop"
    xmlns:converters="using:Agentic.Desktop.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Agentic.Desktop.ViewModels"
    xmlns:msg="using:Agentic.Desktop.ViewModels.Messages"
    xmlns:views="using:Agentic.Desktop.Views"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- User message template -->
        <DataTemplate x:Key="UserMessageTemplate" x:DataType="msg:ChatMessage">
            <Grid HorizontalAlignment="Right" MaxWidth="600" Margin="40,4,8,4">
                <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="12" Padding="14,10">
                    <TextBlock Text="{x:Bind TextContent, Mode=OneWay}"
                               TextWrapping="Wrap" Foreground="{ThemeResource TextOnAccentFillColorPrimary}" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Agent message template -->
        <DataTemplate x:Key="AgentMessageTemplate" x:DataType="msg:ChatMessage">
            <Grid HorizontalAlignment="Left" MaxWidth="600" Margin="8,4,40,4">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="12" Padding="14,10"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind TextContent, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Uid="TypingIndicator"
                                   Visibility="{x:Bind IsStreaming, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Opacity="0.5" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Converters -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!-- Message template selector -->
        <local:ChatMessageTemplateSelector x:Key="ChatTemplateSelector"
                                            UserTemplate="{StaticResource UserMessageTemplate}"
                                            AgentTemplate="{StaticResource AgentMessageTemplate}" />
    </Page.Resources>

    <SplitView x:Name="ChatSplitView"
               DisplayMode="Inline"
               IsPaneOpen="True"
               OpenPaneLength="280"
               PaneBackground="{ThemeResource CardBackgroundFillColorDefaultBrush}">

        <!-- Pane: Chat List Sidebar -->
        <SplitView.Pane>
            <views:ChatListPanel x:Name="ChatListPanel" />
        </SplitView.Pane>

        <!-- Content: Existing chat UI -->
        <SplitView.Content>
            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Toggle button overlay -->
                <Button x:Name="ToggleSidebarButton"
                        Grid.Row="0"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="8,8,0,0"
                        Background="Transparent" BorderThickness="0"
                        Click="ToggleSidebar_Click"
                        x:Uid="ToggleSidebarButton"
                        Canvas.ZIndex="100">
                    <FontIcon Glyph="&#xE700;" FontSize="16" />
                </Button>

                <!-- Message list -->
                <ScrollViewer x:Name="MessageScroller" Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              Padding="8,12">
                    <Grid>
                        <!-- Hint when not connected -->
                        <StackPanel x:Name="ConnectHintPanel"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Spacing="12" Margin="40"
                                    Visibility="{x:Bind ViewModel.IsAgentConnected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='Invert'}">
                            <FontIcon Glyph="&#xE77B;" FontSize="48"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      HorizontalAlignment="Center" />
                            <TextBlock x:Uid="ConnectHint"
                                       FontSize="16"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                            <HyperlinkButton x:Uid="OpenSettingsButton"
                                             HorizontalAlignment="Center"
                                             Click="OpenSettings_Click" />
                        </StackPanel>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
                                       ItemTemplate="{StaticResource ChatTemplateSelector}">
                            <ItemsRepeater.Layout>
                                <!-- StackLayout derives from VirtualizingLayout: virtualization enabled -->
                                <StackLayout Spacing="2" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </Grid>
                </ScrollViewer>

                <!-- Input area: floating composer card -->
                <StackPanel Grid.Row="1" Padding="16,4,16,12"
                            MaxWidth="832" HorizontalAlignment="Stretch" Spacing="6">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="14,6,10,6">
                        <Grid RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Auto-growing multiline input (borderless, embedded in card) -->
                            <TextBox x:Name="InputTextBox"
                                     x:Uid="InputTextBox"
                                     Grid.Row="0"
                                     AutomationProperties.AutomationId="ChatInputTextBox"
                                     Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="28"
                                     MaxHeight="168"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0,4"
                                     IsEnabled="{x:Bind ViewModel.IsAgentConnected, Mode=OneWay}"
                                     KeyDown="InputTextBox_KeyDown" />

                            <!-- Action row -->
                            <Grid Grid.Row="1">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                    <Button x:Name="SendButton"
                                            x:Uid="SendButton"
                                            AutomationProperties.AutomationId="SendButton"
                                            Command="{x:Bind ViewModel.SendMessageCommand}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Width="32" Height="32" Padding="0"
                                            CornerRadius="16"
                                            IsEnabled="{x:Bind local:MainPage.CanSend(ViewModel.IsAgentConnected, ViewModel.InputText), Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.IsAgentResponding, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='Invert'}">
                                        <FontIcon Glyph="&#xE74A;" FontSize="14" />
                                    </Button>
                                    <Button x:Name="CancelButton"
                                            x:Uid="CancelButton"
                                            AutomationProperties.AutomationId="CancelButton"
                                            Command="{x:Bind ViewModel.CancelGenerationCommand}"
                                            Width="32" Height="32" Padding="0"
                                            CornerRadius="16"
                                            Visibility="{x:Bind ViewModel.IsAgentResponding, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <PathIcon Data="M0,0 H10 V10 H0 Z" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Keyboard shortcut hint -->
                    <TextBlock x:Uid="InputHint"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </SplitView.Content>
    </SplitView>
</Page>
