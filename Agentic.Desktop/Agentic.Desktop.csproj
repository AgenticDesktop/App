<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-desktop;net10.0-windows10.0.26100</TargetFrameworks>    <!-- Note: windows target must not be first to avoid Uno debugging/package resolution issues -->

    <RootNamespace>Agentic_Desktop</RootNamespace>
    <UnoSingleProject>true</UnoSingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultLanguage>en</DefaultLanguage>

    <!-- Define WINDOWS symbol for Windows target -->
    <DefineConstants Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">$(DefineConstants);WINDOWS</DefineConstants>

    <!-- Windows-only application manifest -->
    <ApplicationManifest Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Assets (Windows only - for MSIX packaging) -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <!-- Windows-only app manifest -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- MSIX packaging capability (Windows only) -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!-- Cross-platform packages -->
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.10" />
    <PackageReference Include="ShihaoShen.Agentic.ACPLibrary" Version="0.2.0-beta.1" />
  </ItemGroup>

  <!--
  <ItemGroup Condition="!Exists('..\..\ACPLibrary\Agentic.ACPLibrary.csproj')">
    <PackageReference Include="ShihaoShen.Agentic.ACPLibrary" Version="0.2.0-beta.1" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\ACPLibrary\Agentic.ACPLibrary.csproj')">
    <ProjectReference Include="..\..\ACPLibrary\Agentic.ACPLibrary.csproj" />
  </ItemGroup>
  -->

  <!-- Windows-only packages (override Uno.Sdk implicit WinAppSDK version) -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.5.0" />
  </ItemGroup>

  <!-- MSIX packaging property (Windows only) -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Remove Uno packages that conflict with Windows App SDK XAML compiler -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Remove="Uno.UI.App.Mcp" />
    <PackageReference Remove="Uno.UI.HotDesign" />
  </ItemGroup>

  <!-- Remove WPF Skia host for desktop target to avoid NETSDK1136.
       Must run after UnoImplicitPackages since Uno.Sdk injects implicit packages inside that target. -->
  <Target Name="_RemoveWpfSkiaHost" AfterTargets="UnoImplicitPackages" Condition="'$(TargetFramework)' == 'net10.0-desktop'">
    <ItemGroup>
      <PackageReference Remove="Uno.WinUI.Runtime.Skia.Wpf" />
    </ItemGroup>
  </Target>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
    <PackageCertificateThumbprint>280302F4452BD977F1CA50EE1497156A1FD3472C</PackageCertificateThumbprint>
    <PackageCertificateKeyFile>Agentic.Desktop_TemporaryKey.pfx</PackageCertificateKeyFile>
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
  </PropertyGroup>
</Project>
