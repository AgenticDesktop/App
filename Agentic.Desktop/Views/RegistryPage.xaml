<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Agentic_Desktop.RegistryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Agentic_Desktop"
    xmlns:converters="using:Agentic.Desktop.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Agentic.Desktop.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:UrlToImageSourceConverter x:Key="UrlToImageSourceConverter" />
    </Page.Resources>

    <Grid Padding="24" RowDefinitions="Auto,*" RowSpacing="16">
        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <Button x:Uid="RegistryRefresh"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    AutomationProperties.AutomationId="RegistryRefreshButton" />
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       VerticalAlignment="Center"
                       AutomationProperties.AutomationId="RegistryStatusText" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="2*,3*" ColumnSpacing="16">
            <!-- Agent list -->
            <ListView x:Name="AgentListView"
                      ItemsSource="{x:Bind ViewModel.Agents}"
                      SelectedItem="{x:Bind ViewModel.SelectedAgent, Mode=TwoWay}"
                      SelectionMode="Single"
                      AutomationProperties.AutomationId="RegistryAgentList">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:RegistryAgentItem">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="4,6">
                            <Border Width="36" Height="36" CornerRadius="6"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Top">
                                <Grid>
                                    <Image x:Name="ListIconImage"
                                           Source="{x:Bind IconUrl, Mode=OneWay, Converter={StaticResource UrlToImageSourceConverter}}"
                                           Width="24" Height="24" Stretch="Uniform"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                           ImageFailed="AgentIcon_ImageFailed" />
                                    <TextBlock Text="{x:Bind Initials, Mode=OneWay}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='Invert'}" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Version}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="4" Padding="6,1"
                                            Visibility="{x:Bind IsInstalled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind InstallKindText, Mode=OneWay}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind Description}" MaxLines="1"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Details -->
            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="RegistryNoSelection"
                               Visibility="{x:Bind ViewModel.NoSelection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <StackPanel Spacing="12"
                                Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="48" Height="48" CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Top">
                                <Grid>
                                    <Image x:Name="DetailIconImage"
                                           Source="{x:Bind ViewModel.SelectedAgent.IconUrl, Mode=OneWay, Converter={StaticResource UrlToImageSourceConverter}}"
                                           Width="32" Height="32" Stretch="Uniform"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{x:Bind ViewModel.SelectedAgent.HasIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                           ImageFailed="AgentIcon_ImageFailed" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedAgent.Initials, Mode=OneWay}"
                                               FontSize="18" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{x:Bind ViewModel.SelectedAgent.HasIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='Invert'}" />
                                </Grid>
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedAgent.Name, Mode=OneWay}"
                                               FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedAgent.Version, Mode=OneWay}"
                                               FontSize="16"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Bottom" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.SelectedAgent.Description, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Installation status -->
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    Visibility="{x:Bind ViewModel.SelectedAgent.IsInstalled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="6,1">
                                <TextBlock x:Uid="RegistryInstalledBadge"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                            <TextBlock Text="{x:Bind ViewModel.SelectedAgent.InstallKindText, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedAgent.InstalledVersion, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Uid="RegistryUpdateAvailable"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   Visibility="{x:Bind ViewModel.SelectedAgent.IsUpToDate, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='Invert'}" />

                        <TextBlock x:Uid="RegistryNotInstalled"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind ViewModel.SelectedAgent.IsInstalled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='Invert'}" />

                        <!-- Launch -->
                        <Button x:Uid="RegistryLaunch"
                                Command="{x:Bind ViewModel.LaunchCommand}"
                                Style="{ThemeResource AccentButtonStyle}"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="RegistryLaunchButton" />

                        <!-- Metadata -->
                        <StackPanel Spacing="8" Margin="0,8,0,0">
                            <TextBlock x:Uid="RegistryRepositoryLabel" FontWeight="SemiBold" />
                            <HyperlinkButton Content="{x:Bind ViewModel.SelectedAgent.Repository, Mode=OneWay}"
                                             NavigateUri="{x:Bind ViewModel.SelectedAgent.RepositoryUri, Mode=OneWay}"
                                             Padding="0" HorizontalAlignment="Left"
                                             Visibility="{x:Bind ViewModel.SelectedAgent.HasRepository, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <TextBlock x:Uid="RegistryWebsiteLabel" FontWeight="SemiBold" />
                            <HyperlinkButton Content="{x:Bind ViewModel.SelectedAgent.Website, Mode=OneWay}"
                                             NavigateUri="{x:Bind ViewModel.SelectedAgent.WebsiteUri, Mode=OneWay}"
                                             Padding="0" HorizontalAlignment="Left"
                                             Visibility="{x:Bind ViewModel.SelectedAgent.HasWebsite, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <TextBlock x:Uid="RegistryAuthorsLabel" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedAgent.AuthorsText, Mode=OneWay}"
                                       TextWrapping="Wrap" />

                            <TextBlock x:Uid="RegistryLicenseLabel" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedAgent.License, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
