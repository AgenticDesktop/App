<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Agentic.Desktop.Views.ChatListPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Agentic.Desktop.ViewModels"
    xmlns:msg="using:Agentic.Desktop.ViewModels.Messages"
    xmlns:converters="using:Agentic.Desktop.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: Title + New Chat button -->
        <Grid Grid.Row="0" Padding="12,12,12,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Uid="ChatListTitle" Grid.Column="0"
                       FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center" />

            <Button x:Uid="NewChatButton" Grid.Column="1"
                    Command="{x:Bind ViewModel.CreateNewChatCommand, Mode=OneWay}"
                    Background="Transparent" BorderThickness="0"
                    VerticalAlignment="Center"
                    Padding="6">
                <FontIcon Glyph="&#xE710;" FontSize="16" />
            </Button>
        </Grid>

        <!-- Chat list -->
        <ListView x:Name="ChatListView"
                  Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Sessions, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=TwoWay}"
                  SelectionChanged="ChatListView_SelectionChanged"
                  Padding="4,0">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="msg:ChatSession">
                    <Grid Padding="8,8" ColumnSpacing="8"
                          Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2"
                                    VerticalAlignment="Center"
                                    MaxWidth="200">
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"
                                       FontSize="13" />
                            <TextBlock Text="{x:Bind PreviewText, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Button x:Uid="DeleteChatButton" Grid.Column="1"
                                VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0"
                                Padding="4" Opacity="0.6"
                                Click="DeleteChat_Click"
                                Tag="{x:Bind}">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </Grid>
</UserControl>
